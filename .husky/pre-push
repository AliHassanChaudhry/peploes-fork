set -eu

[ -n "${CI:-}" ] && exit 0

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/dev|refs/heads/main)
      if [ "${ALLOW_PROTECTED_PUSH:-}" != "true" ]; then
        echo "Push to '$remote_ref' rejected. Use a PR."
        echo "For an explicitly authorized exception, use ALLOW_PROTECTED_PUSH=true."
        exit 1
      fi
      ;;
  esac
done

bun run lint
bun run type-check
