# ═══════════════════════════════════════════════════════════════════════════
#  Environment Variables
#  Schema validated in: src/lib/env.ts
#  Add new vars to BOTH: src/lib/env.ts AND this file
# ═══════════════════════════════════════════════════════════════════════════

# ─── Server-Only ───────────────────────────────────────────────────────────
# These are NEVER exposed to the browser. Accessible only in Server Components,
# Server Actions, API Routes, and Route Handlers.

# Database — REQUIRED for any project using Drizzle
DATABASE_URL=postgres://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/app_db
DATABASE_POOL_SIZE=10

# Next.js sets NODE_ENV for development, tests, and production builds.
# Do not override it in an environment file.
PORT=3000

# Sentry: configure the same project's DSN in both server and public variables.
# Reporting and source-map upload run only when VERCEL_ENV=production.
# Keep the auth token in ignored local settings or the deployment build environment.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Google Analytics Measurement Protocol (server-side events)
GA_API_SECRET=

# System alert email recipient
ADMIN_EMAIL=

# CORS allowed origins (space-separated)
ALLOWED_ORIGINS=http://localhost:3000

# ResDiary online booking. Booking stays off until all five are set.
# Sandbox host: https://api.rdbranch.com (the live host comes from ResDiary).
# Never use the PAYSKIP channel code in production.
RESDIARY_API_URL=
RESDIARY_MICROSITE_NAME=
RESDIARY_CHANNEL_CODE=
RESDIARY_USERNAME=
RESDIARY_PASSWORD=

# Signs the table-hold cookie: at least 32 random characters, for example
# from `openssl rand -base64 32`. Online booking stays off without it.
BOOKING_HOLD_SECRET=

# Upstash Redis for the per-visitor table-hold limit (Upstash console, REST
# API). Without both, holds are not rate-limited: set them before launch.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set by Vercel itself (production, preview or development); leave it unset
# locally. Only the live site refuses ResDiary's Stripe test key, so previews
# against the sandbox can take test payments.
# VERCEL_ENV=

# ─── Client-Side (NEXT_PUBLIC_ prefix) ─────────────────────────────────────
# These ARE bundled and exposed to the browser. Only put values here that
# are safe to be public. NEVER put secrets or API keys here.

# Site URL — REQUIRED for SEO canonical URLs, sitemap, OG images
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT is derived by next.config.ts from VERCEL_ENV.
# Do not set it manually. Changing a public DSN requires rebuilding the site.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
# Browser analytics collect only when this is "production". next.config.ts fills it from Vercel's build-time VERCEL_ENV; set it explicitly for another host or a QA build. Unset means off.
NEXT_PUBLIC_VERCEL_ENV=
NEXT_PUBLIC_GA_ENDPOINT=https://www.google-analytics.com/mp/collect
# PostHog project token and the ingestion host of its region (https://us.i.posthog.com or https://eu.i.posthog.com). Both are required to enable PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional interactive Visit map. Use a public (pk.) development token;
# replace it with the client's URL-restricted public token for production.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# A custom Mapbox Studio style can replace the branded light-map default.
NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/light-v11


# Published public menu content; no API token is needed by the website.
SANITY_PROJECT_ID=3ggctsor
SANITY_DATASET=development
SANITY_API_VERSION=2026-10-06
