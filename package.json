{
  "name": "nextjs-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "prepare": "husky",
    "type-check": "next typegen && tsc --noEmit",
    "validate": "bun run lint && bun run type-check && bun run test",
    "ci": "bun run validate && NODE_ENV=production bun run build && bun audit --audit-level high"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.72.0",
    "@t3-oss/env-core": "^0.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^0.511.0",
    "neverthrow": "^6.2.2",
    "next": "16.3.3",
    "postgres": "^3.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "web-vitals": "^5.3.0",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "terser-webpack-plugin": "^5.6.1"
  },
  "trustedDependencies": [
    "@sentry/cli"
  ]
}
