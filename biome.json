{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.omo/run-continuation",
      "!**/out",
      "!**/build",
      "!**/coverage",
      "!**/next-env.d.ts",
      "!**/src/db/migrations",
      "!**/playwright-report",
      "!**/test-results"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf",
    "formatWithErrors": false
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "drizzle": "recommended",
      "next": "recommended",
      "project": "recommended",
      "react": "recommended",
      "tailwind": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": {
          "level": "error"
        },
        "noUnusedFunctionParameters": {
          "level": "error"
        },
        "noUnusedVariables": {
          "level": "error"
        }
      },
      "performance": {
        "noAccumulatingSpread": {
          "level": "error"
        },
        "noDelete": {
          "level": "error"
        }
      },
      "security": {
        "noGlobalEval": {
          "level": "error"
        }
      },
      "suspicious": {
        "noExplicitAny": {
          "level": "error"
        },
        "noFocusedTests": {
          "level": "error"
        },
        "noImportantInKeyframe": {
          "level": "error"
        },
        "noImplicitAnyLet": {
          "level": "error"
        },
        "noGlobalIsNan": {
          "level": "error"
        },
        "noFunctionAssign": {
          "level": "error"
        },
        "useAwait": {
          "level": "error"
        },
        "useIsArray": {
          "level": "error"
        },
        "noUnsafeNegation": {
          "level": "error"
        },
        "noReactSpecificProps": {
          "level": "error"
        },
        "noSkippedTests": {
          "level": "error"
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noUselessTernary": {
          "level": "error"
        },
        "noForEach": {
          "level": "error"
        }
      },
      "style": {
        "noUselessElse": "error",
        "useImportType": {
          "level": "error"
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "requireAscii": false,
            "conventions": [
              {
                "selector": {
                  "kind": "interface"
                },
                "formats": ["PascalCase"],
                "match": "I[A-Z].*"
              },
              {
                "selector": {
                  "kind": "typeAlias"
                },
                "formats": ["PascalCase"],
                "match": "T[A-Z].*"
              },
              {
                "selector": {
                  "kind": "enum"
                },
                "formats": ["PascalCase"]
              }
            ]
          }
        },
        "useExportType": {
          "level": "off"
        },
        "useFragmentSyntax": {
          "level": "error"
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/src/**/*.tsx", "**/src/**/*.jsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noReactSpecificProps": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/vitest.config.ts",
        "**/src/lib/constants.ts",
        "**/src/lib/config.ts",
        "**/src/helpers/api.ts",
        "**/src/lib/env.ts",
        "**/src/lib/types.ts",
        "**/src/lib/analytics/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/helpers/cookies.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/lib/types.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/__tests__/**"],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          },
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    }
  ]
}
