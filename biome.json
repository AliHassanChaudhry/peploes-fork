{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.omo/run-continuation",
      "!**/out",
      "!**/build",
      "!**/coverage",
      "!**/next-env.d.ts",
      "!**/src/db/migrations",
      "!**/playwright-report",
      "!**/test-results"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf",
    "formatWithErrors": false
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "drizzle": "recommended",
      "next": "recommended",
      "project": "recommended",
      "react": "recommended",
      "tailwind": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": {
          "level": "error"
        },
        "noUnusedFunctionParameters": {
          "level": "error"
        },
        "noUnusedVariables": {
          "level": "error"
        }
      },
      "performance": {
        "noAccumulatingSpread": {
          "level": "error"
        },
        "noDelete": {
          "level": "error"
        }
      },
      "security": {
        "noGlobalEval": {
          "level": "error"
        }
      },
      "suspicious": {
        "noExplicitAny": {
          "level": "error"
        },
        "noFocusedTests": {
          "level": "error"
        },
        "noImportantInKeyframe": {
          "level": "error"
        },
        "noImplicitAnyLet": {
          "level": "error"
        },
        "noGlobalIsNan": {
          "level": "error"
        },
        "noFunctionAssign": {
          "level": "error"
        },
        "useAwait": {
          "level": "error"
        },
        "useIsArray": {
          "level": "error"
        },
        "noUnsafeNegation": {
          "level": "error"
        },
        "noReactSpecificProps": {
          "level": "error"
        },
        "noSkippedTests": {
          "level": "error"
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noUselessTernary": {
          "level": "error"
        },
        "noForEach": {
          "level": "error"
        }
      },
      "style": {
        "noUselessElse": "error",
        "useImportType": {
          "level": "error"
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "requireAscii": false,
            "conventions": [
              {
                "selector": {
                  "kind": "interface"
                },
                "formats": ["PascalCase"],
                "match": "I[A-Z].*"
              },
              {
                "selector": {
                  "kind": "typeAlias"
                },
                "formats": ["PascalCase"],
                "match": "T[A-Z].*"
              },
              {
                "selector": {
                  "kind": "enum"
                },
                "formats": ["PascalCase"]
              }
            ]
          }
        },
        "useExportType": {
          "level": "off"
        },
        "useFragmentSyntax": {
          "level": "error"
        }
      },
      "nursery": {
        "useImportsFirst": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/src/**/*.tsx", "**/src/**/*.jsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noReactSpecificProps": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/vitest.config.ts",
        "**/src/lib/constants.ts",
        "**/src/lib/config.ts",
        "**/src/helpers/api.ts",
        "**/src/lib/env.ts",
        "**/src/lib/types.ts",
        "**/src/lib/analytics/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/helpers/cookies.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/lib/types.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/__tests__/**"],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          },
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/services/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "next",
                      "next/**",
                      "react",
                      "react/**",
                      "**/db",
                      "**/db/**",
                      "**/actions/**",
                      "**/app/**",
                      "**/components/**",
                      "**/actions",
                      "**/app",
                      "**/components",
                      "postgres",
                      "postgres/**",
                      "drizzle-orm",
                      "drizzle-orm/**"
                    ],
                    "message": "Services own domain rules. Use the DAL or a concrete provider adapter; keep framework and SDK configuration outside services."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/dal/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/services/**",
                      "**/actions/**",
                      "**/app/**",
                      "**/components/**",
                      "next",
                      "next/**",
                      "react",
                      "react/**",
                      "**/services",
                      "**/actions",
                      "**/app",
                      "**/components"
                    ],
                    "message": "DAL dependencies point toward persistence, never services or framework entry points."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/actions/**",
        "**/src/app/**",
        "**/src/components/**",
        "**/src/hooks/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/dal/**",
                      "**/db",
                      "**/db/**",
                      "**/dal",
                      "postgres",
                      "postgres/**",
                      "drizzle-orm",
                      "drizzle-orm/**"
                    ],
                    "message": "Application entry points call domain services rather than querying persistence directly."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/lib/*-provider.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/services",
                      "**/services/**",
                      "**/actions",
                      "**/actions/**",
                      "**/app",
                      "**/app/**",
                      "**/components",
                      "**/components/**"
                    ],
                    "message": "Concrete providers own integration details and must not depend on services or application entry points."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/actions/**",
        "**/src/app/**",
        "**/src/services/**",
        "**/src/dal/**",
        "**/src/components/**",
        "**/src/hooks/**",
        "**/scripts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          },
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    }
  ]
}
